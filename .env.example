# Copy values into your local .env. Never commit a real API key.
BASE_URL=https://api.deepseek.com/v1
API_KEY=your-api-key
MODEL=deepseek-v4-flash

# Initial preferences; saved settings from the tray take precedence.
HOTKEY=alt+q
AUTO_SELECT=true

# Selection capture: compatible (recommended), manual, never, or allowlist.
# Compatible allows one automatic copy in WeChat when direct selection is unavailable.
CLIPBOARD_FALLBACK=compatible
CLIPBOARD_APPS=
EXCLUDED_APPS=

# Stream answers to the UI. Use false for endpoints without SSE support.
LLM_STREAM=true

# Only sent to official api.deepseek.com endpoints with deepseek-v4-* models.
# Values: disabled (fast default), enabled (thinking), default (provider default).
DEEPSEEK_TRANSLATION_THINKING=disabled
DEEPSEEK_THINKING=disabled
